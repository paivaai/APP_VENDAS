# Copie para .env na VPS (/opt/pdp/.env) e preencha. NUNCA commite o .env.

# --- Banco ---
POSTGRES_USER=pdp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pdp
DATABASE_URL=postgresql://pdp:troque-esta-senha@postgres:5432/pdp

# --- Auth ---
SECRET_KEY=gere-com-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_COMPLEX=

# --- Mercado Livre ---
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://api.pdp.paivaai.com.br/integrations/mercadolivre/callback

# --- Bling (Shopee via Bling) ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=https://api.pdp.paivaai.com.br/integrations/bling/callback

# --- TikTok Shop ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# --- Evolution API (WhatsApp) ---
EVOLUTION_SERVER_URL=https://evolution.paivaai.com.br
EVOLUTION_API_KEY=gere-com-openssl-rand-hex-32
EVOLUTION_DB_NAME=evolution

# --- Criptografia de tokens OAuth guardados no banco ---
TOKEN_ENCRYPTION_KEY=
